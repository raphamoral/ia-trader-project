# Copy to .env (git-ignored). Every value is optional.
# TRADER_LLM_PROVIDER=ollama          # ollama | claude-cli | anthropic
# TRADER_LLM_MODEL=
# TRADER_LLM_URL=http://localhost:11434/v1
# TRADER_CLAUDE_CMD=claude            # command for the claude-cli provider
# TRADER_CONTACT_EMAIL=you@example.com  # sources such as Wikimedia, GitHub and the SEC ask for a contact
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
